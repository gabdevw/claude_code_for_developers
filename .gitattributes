# Keep Unix line endings so scripts work on every OS (including Windows + Git Bash).
# Mantener finales de línea Unix para que los scripts funcionen en todo sistema (incluido Windows + Git Bash).
* text=auto
*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
.worktreeinclude text eol=lf
